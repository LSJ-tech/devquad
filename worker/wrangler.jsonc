{
  "name": "devquad-contact",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-23",
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "logan.silva.jara@outlook.com"
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "devquad.cl/api/contact",
      "zone_name": "devquad.cl"
    }
  ]
}
